TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Initial setup only; remove the password variable after first login.
SEVATRACK_ADMIN_EMAIL=
SEVATRACK_ADMIN_NAME=
SEVATRACK_ADMIN_PASSWORD=

# Optional: exact college-host mappings; see LAUNCH-VERIFICATION.md.
# Leave unset for the existing single-college database and private Blob store.
# SEVATRACK_COLLEGES=

# Private temporary password for new spreadsheet-imported students (12–128 characters).
# First login requires a new password. For routed colleges use SEVATRACK_<COLLEGE_ID>_IMPORT_PASSWORD.
SEVATRACK_IMPORT_PASSWORD=
